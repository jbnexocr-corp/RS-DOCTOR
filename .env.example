PUBLIC_SITE_URL=
PUBLIC_GA4_ID=
PUBLIC_PREVIEW_HOST=.lhr.life,.serveousercontent.com
# Dominios adicionales en los que responde el sitio (además de PUBLIC_SITE_URL y *.up.railway.app)
ALLOWED_HOSTS=

# Railway PostgreSQL
DATABASE_URL=
DATABASE_POOL_SIZE=4
MAX_CONCURRENT_REQUESTS=48

# Login del panel /admin/. La contraseña nunca se guarda en texto plano.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# Railway Bucket (inyectar credenciales desde el recurso Bucket)
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
ENDPOINT=
REGION=auto
BUCKET_FORCE_PATH_STYLE=false
