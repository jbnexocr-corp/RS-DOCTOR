---
import doctorHeroPoster from '@/assets/images/doctor-hero-video-poster.jpg';
import doctorProfile from '@/assets/images/doctor-blue-seated.jpeg';
import doctorSurgery from '@/assets/images/doctor-operating-room.jpeg';
import type { HomeContent } from '@/data/home';
import type { Locale } from '@/lib/i18n';
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/footer/SiteFooter.astro';
import { formatPlaceholder } from '@/lib/placeholders';
import { contactDetails } from '@/data/contact';
import ScrollScrubHero from '@/components/media/ScrollScrubHero.astro';

interface Props { locale: Locale; content: HomeContent }
const { locale, content } = Astro.props;
const pillarHrefs = locale === 'es'
  ? ['/es/gineco-obstetricia/', '/es/ginecologia/', '/es/cirugia-ginecologica/', '/es/salud-intima/', '/es/piso-pelvico/', '/es/atencion-integral/']
  : ['/en/obstetrics/', '/en/gynecology/', '/en/gynecological-surgery/', '/en/intimate-health/', '/en/pelvic-floor/', '/en/integrated-care/'];
---

<SiteHeader {locale} content={content.nav} />
<main id="main-content">
  <ScrollScrubHero {locale} content={content.hero} poster={doctorHeroPoster} videoSrc="/videos/dr-ronald-hero-scroll.mp4" />

  <section class="services section" id="servicios" aria-labelledby="services-title">
    <div class="section-intro page-shell">
      <p class="eyebrow">{content.services.eyebrow}</p>
      <div class="section-heading-grid">
        <h2 id="services-title">{content.services.title}</h2>
        <p>{content.services.intro}</p>
      </div>
    </div>
    <ol class="service-list page-shell">
      {content.services.items.map((item, index) => (
        <li>
          <span class="service-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <a href={pillarHrefs[index]}><h3>{item.title}</h3><p>{item.text}</p></a>
          <span class="service-arrow" aria-hidden="true">↗</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="doctor-section section" id="doctor" aria-labelledby="doctor-title">
    <div class="doctor-grid page-shell">
      <figure class="editorial-image editorial-image-tall">
        <ResponsiveImage src={doctorProfile} alt={content.doctor.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 900px) 43vw, 100vw" />
      </figure>
      <div class="doctor-copy">
        <p class="eyebrow">{content.doctor.eyebrow}</p>
        <h2 id="doctor-title">{content.doctor.title}</h2>
        <p class="lead-copy">{content.doctor.text}</p>
        <p class="pending-line"><span aria-hidden="true"></span>{formatPlaceholder(content.doctor.pending, locale)}</p>
        <a class="text-link" href={locale === 'es' ? '/es/dr-ronald-salazar/' : '/en/doctor-ronald-salazar/'}>{content.doctor.link}<span aria-hidden="true"> →</span></a>
      </div>
    </div>
  </section>

  <section class="principles section" aria-labelledby="principles-title">
    <div class="page-shell">
      <p class="eyebrow">{content.principles.eyebrow}</p>
      <h2 id="principles-title">{content.principles.title}</h2>
      <div class="principle-list">
        {content.principles.items.map((item, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="surgery section" id="cirugia" aria-labelledby="surgery-title">
    <div class="surgery-grid page-shell">
      <div class="surgery-copy">
        <p class="eyebrow eyebrow-light">{content.surgery.eyebrow}</p>
        <h2 id="surgery-title">{content.surgery.title}</h2>
        <p>{content.surgery.text}</p>
      <a class="text-link text-link-light" href={locale === 'es' ? '/es/cirugia-ginecologica/' : '/en/gynecological-surgery/'}>{content.surgery.link}<span aria-hidden="true"> →</span></a>
      </div>
      <figure class="surgery-image">
        <ResponsiveImage src={doctorSurgery} alt={content.surgery.imageAlt} widths={[480, 720, 960]} sizes="(min-width: 900px) 48vw, 100vw" />
        <figcaption>{content.surgery.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="resources section" id="recursos" aria-labelledby="resources-title">
    <div class="resources-intro page-shell">
      <p class="eyebrow">{content.resources.eyebrow}</p>
      <div class="section-heading-grid">
        <h2 id="resources-title">{content.resources.title}</h2>
        <p>{content.resources.intro}</p>
      </div>
    </div>
    <div class="resource-lines page-shell">
      <article>
        <span class="resource-index">01</span>
        <div><h3>{content.resources.bookTitle}</h3><p>{content.resources.bookText}</p></div>
        <span class="pending-tag">{formatPlaceholder(locale === 'es' ? 'Contenido pendiente' : 'Content pending', locale)}</span>
      </article>
      <article>
        <span class="resource-index">02</span>
        <div><h3>{content.resources.courseTitle}</h3><p>{content.resources.courseText}</p></div>
        <span class="pending-tag">{formatPlaceholder(locale === 'es' ? 'Contenido pendiente' : 'Content pending', locale)}</span>
      </article>
    </div>
    <p class="resources-pending page-shell">{formatPlaceholder(content.resources.pending, locale)}</p>
  </section>

  <section class="practice-overview section" aria-labelledby="practice-title">
    <div class="page-shell">
      <p class="eyebrow">{locale === 'es' ? 'Clínica y equipo' : 'Clinic and team'}</p>
      <div class="section-heading-grid">
        <h2 id="practice-title">{locale === 'es' ? 'Una atención coordinada y transparente' : 'Coordinated, transparent care'}</h2>
        <p>{locale === 'es' ? 'Esta sección está preparada para presentar la clínica, las instalaciones y cada profesional interdisciplinario con su rol y formación confirmados.' : 'This section is prepared to present the clinic, facilities, and each interdisciplinary professional with a confirmed role and education.'}</p>
      </div>
      <div class="practice-lines">
        <article><span>01</span><h3>{locale === 'es' ? 'Equipo profesional' : 'Professional team'}</h3><p>{formatPlaceholder(locale === 'es' ? 'Perfiles, roles, formación y fotografías pendientes' : 'Profiles, roles, education, and photographs pending', locale)}</p></article>
        <article><span>02</span><h3>{locale === 'es' ? 'Clínica e instalaciones' : 'Clinic and facilities'}</h3><p>{formatPlaceholder(locale === 'es' ? 'Fotografías, accesibilidad e indicaciones pendientes' : 'Photographs, accessibility, and directions pending', locale)}</p></article>
        <article><span>03</span><h3>{locale === 'es' ? 'Ubicación y horarios' : 'Location and hours'}</h3><p>{formatPlaceholder(locale === 'es' ? 'Dirección, mapa, parqueo y horarios pendientes' : 'Address, map, parking, and hours pending', locale)}</p></article>
      </div>
    </div>
  </section>

  <section class="home-articles section" aria-labelledby="home-articles-title">
    <div class="page-shell home-articles-grid">
      <div><p class="eyebrow">{locale === 'es' ? 'Artículos recientes' : 'Recent articles'}</p><h2 id="home-articles-title">{locale === 'es' ? 'Información revisada para tomar mejores decisiones' : 'Reviewed information for better decisions'}</h2></div>
      <div><p>{locale === 'es' ? 'El sistema editorial está listo para mostrar artículos únicamente cuando tengan autor, revisión médica, fecha y fuentes.' : 'The editorial system is ready to display articles only after they have an author, medical review, date, and sources.'}</p><a class="text-link" href={locale === 'es' ? '/es/articulos/' : '/en/articles/'}>{locale === 'es' ? 'Visitar la biblioteca' : 'Visit the library'}<span aria-hidden="true"> →</span></a></div>
    </div>
  </section>

  <section class="contact-section" id="contacto" aria-labelledby="contact-title">
    <div class="contact-grid page-shell">
      <div>
        <p class="eyebrow eyebrow-light">{content.contact.eyebrow}</p>
        <h2 id="contact-title">{content.contact.title}</h2>
      </div>
      <div class="contact-copy">
        <p>{content.contact.text}</p>
        <a class="button button-gold" href={contactDetails.whatsapp.href} target="_blank" rel="noopener noreferrer" data-analytics-event="click_whatsapp" data-analytics-placement="home_contact">{content.contact.primary}</a>
        <a class="contact-home-phone" href={contactDetails.phone.href} data-analytics-event="click_phone" data-analytics-placement="home_contact">{content.contact.secondary}: {contactDetails.phone.display}</a>
        <a class="text-link text-link-light" href={locale === 'es' ? '/es/contacto/' : '/en/contact/'}>{locale === 'es' ? 'Ver todas las opciones de contacto' : 'View all contact options'}<span aria-hidden="true"> →</span></a>
        <p class="contact-pending" id="estado-contacto">{content.contact.pending}</p>
      </div>
    </div>
  </section>
</main>
<SiteFooter {locale} content={content.footer} nav={content.nav} />
