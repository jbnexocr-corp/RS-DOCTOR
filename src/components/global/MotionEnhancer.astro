<script is:inline>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const saveData = navigator.connection?.saveData === true;
    if (reduced || saveData) {
      document.documentElement.dataset.motion = 'reduced';
      return;
    }

    document.documentElement.dataset.motion = 'enhanced';

    const selectors = [
      'main h1',
      'main h2',
      'main h3',
      'main p',
      'main li',
      'main article',
      'main figure',
      'main .button',
      'main .text-link',
      'main .review-status',
      'main .breadcrumbs',
      '.site-footer > *',
    ];

    const selector = selectors.join(',');
    // Solo se anima el elemento exterior: si un artículo y su párrafo se animaran
    // a la vez, sus desplazamientos se sumarían y el texto quedaría descuadrado.
    const elements = [...document.querySelectorAll(selector)]
      .filter((element) => !element.closest('[data-motion-ignore]'))
      .filter((element) => !element.parentElement?.closest(selector));

    elements.forEach((element, index) => {
      element.classList.add('motion-reveal');
      element.style.setProperty('--motion-order', String(index % 7));
      if (element.matches('figure, picture, img')) element.classList.add('motion-media');
      if (element.matches('h1, h2, h3')) element.classList.add('motion-heading');
    });

    const pendingElements = new Set(elements);
    const reveal = (element) => {
      element.classList.add('motion-visible');
      pendingElements.delete(element);
    };

    const progress = document.createElement('span');
    progress.className = 'motion-scroll-progress';
    progress.setAttribute('aria-hidden', 'true');
    document.body.append(progress);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        reveal(entry.target);
        observer.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });

    elements.forEach((element) => observer.observe(element));

    const parallaxMedia = [...document.querySelectorAll('main figure img')];
    const activeParallax = new Set();
    const parallaxObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) activeParallax.add(entry.target);
        else activeParallax.delete(entry.target);
      });
    }, { rootMargin: '20% 0px' });
    parallaxMedia.forEach((image) => parallaxObserver.observe(image));

    let ticking = false;
    const revealNearViewport = () => {
      if (!pendingElements.size) return;
      const viewport = window.innerHeight;
      // Primero se miden todos los elementos y después se modifican, para no
      // forzar un recálculo de diseño por cada elemento.
      const visible = [...pendingElements].filter((element) => {
        const rect = element.getBoundingClientRect();
        return rect.top <= viewport * 1.12 && rect.bottom >= viewport * -.12;
      });
      visible.forEach((element) => {
        reveal(element);
        observer.unobserve(element);
      });
    };
    const updateParallax = () => {
      const viewport = window.innerHeight;
      const scrollable = document.documentElement.scrollHeight - viewport;
      const offsets = [...activeParallax].map((image) => {
        const rect = image.getBoundingClientRect();
        const mediaProgress = (rect.top + rect.height / 2 - viewport / 2) / viewport;
        return [image, Math.max(-14, Math.min(14, mediaProgress * -24))];
      });
      revealNearViewport();
      progress.style.setProperty('--reading-progress', String(scrollable > 0 ? Math.min(1, window.scrollY / scrollable) : 0));
      offsets.forEach(([image, offset]) => image.style.setProperty('--parallax-y', `${offset}px`));
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(updateParallax);
    }, { passive: true });
    window.addEventListener('resize', revealNearViewport, { passive: true });
    document.addEventListener('pointerdown', (event) => {
      const target = event.target instanceof Element ? event.target.closest('a, button, summary') : null;
      if (!target) return;
      target.classList.remove('motion-tap');
      requestAnimationFrame(() => target.classList.add('motion-tap'));
      setTimeout(() => target.classList.remove('motion-tap'), 380);
    }, { passive: true });
    window.addEventListener('beforeprint', () => pendingElements.forEach(reveal));
    updateParallax();
    window.setTimeout(revealNearViewport, 600);
  })();
</script>
