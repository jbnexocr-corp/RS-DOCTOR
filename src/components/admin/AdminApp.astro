---
import { buildSeedRecords } from '@/lib/admin/seed';

const databaseMode = Boolean(process.env.DATABASE_URL);
const initialRecords = buildSeedRecords();
---

<div class="admin-shell" data-admin-app data-admin-mode={databaseMode ? 'database' : 'local'} data-seed={JSON.stringify(initialRecords)}>
  <aside class="admin-sidebar">
    <a class="admin-brand" href="/es/" aria-label="Volver al sitio">
      <span>RS</span><b>Estudio editorial</b>
    </a>
    <nav aria-label="Administración">
      <button type="button" class="is-active" data-view="dashboard">Resumen</button>
      <button type="button" data-view="content">Contenido</button>
      <button type="button" data-view="settings">Configuración</button>
      <button type="button" data-view="backup">Respaldo</button>
    </nav>
    <div class="admin-mode">
      <span></span>
      <p><strong>{databaseMode ? 'Railway PostgreSQL' : 'Modo local'}</strong>{databaseMode ? 'Contenido sincronizado y persistente.' : 'Los cambios se guardan únicamente en este navegador.'}</p>
    </div>
  </aside>

  <main class="admin-main">
    <header class="admin-topbar">
      <div><p>Dr. Ronald Salazar</p><h1>Panel de administración</h1></div>
      <div class="admin-top-actions"><span id="save-indicator" role="status">Cargando…</span><button class="admin-primary" type="button" data-new-record>Nuevo contenido</button><form method="post" action="/api/auth/logout/"><button class="secondary-button" type="submit">Cerrar sesión</button></form></div>
    </header>

    <section class="admin-view" data-panel="dashboard">
      <div class="admin-section-heading"><div><p class="admin-kicker">Estado editorial</p><h2>Vista general</h2></div><p>{databaseMode ? 'Control persistente de contenido, artículos y medios en Railway.' : 'Control local de páginas, servicios, artículos, equipo, ubicaciones y recursos.'}</p></div>
      <div class="metric-grid" id="metric-grid"></div>
      <div class="dashboard-grid">
        <article class="admin-card">
          <div class="card-heading"><h3>Actividad reciente</h3><button type="button" class="text-button" data-view-link="content">Ver contenido</button></div>
          <div id="recent-list" class="activity-list"></div>
        </article>
        <article class="admin-card readiness-card">
          <div class="card-heading"><h3>Preparación para publicar</h3><span id="readiness-value">0%</span></div>
          <div class="progress-track"><span id="readiness-bar"></span></div>
          <ul id="readiness-list"></ul>
        </article>
      </div>
      <article class="admin-card audit-card">
        <div class="card-heading"><h3>Registro de actividad</h3>{!databaseMode && <button type="button" class="text-button" id="clear-audit">Limpiar</button>}</div>
        <div id="audit-list" class="audit-list"></div>
      </article>
    </section>

    <section class="admin-view" data-panel="content" hidden>
      <div class="admin-section-heading"><div><p class="admin-kicker">CRUD editorial</p><h2>Contenido y medios</h2></div><p>Crea, revisa, duplica, publica, archiva o elimina registros y fotografías.</p></div>
      <div class="content-toolbar">
        <label><span class="visually-hidden">Buscar</span><input id="content-search" type="search" placeholder="Buscar por título o slug" /></label>
        <label><span class="visually-hidden">Colección</span><select id="collection-filter"><option value="all">Todas las colecciones</option><option value="pages">Páginas</option><option value="services">Servicios</option><option value="articles">Artículos</option><option value="team">Equipo</option><option value="locations">Ubicaciones</option><option value="resources">Recursos</option><option value="media">Medios</option></select></label>
        <label><span class="visually-hidden">Estado</span><select id="status-filter"><option value="all">Todos los estados</option><option value="draft">Borrador</option><option value="pending-medical-review">Revisión médica</option><option value="approved">Aprobado</option><option value="published">Publicado</option><option value="archived">Archivado</option></select></label>
      </div>
      <div class="content-table-wrap">
        <table class="content-table">
          <thead><tr><th>Contenido</th><th>Colección</th><th>Idioma</th><th>Estado</th><th>Actualizado</th><th><span class="visually-hidden">Acciones</span></th></tr></thead>
          <tbody id="content-table-body"></tbody>
        </table>
      </div>
      <p id="empty-state" class="empty-state" hidden>No hay contenido que coincida con estos filtros.</p>
    </section>

    <section class="admin-view" data-panel="settings" hidden>
      <div class="admin-section-heading"><div><p class="admin-kicker">Preparación técnica</p><h2>Configuración</h2></div><p>Datos de referencia y lista de verificación para la entrega. No modifican el sitio público: el contacto se edita en el código y el dominio y Analytics se configuran en las variables de Railway.</p></div>
      <form id="settings-form" class="settings-grid">
        <fieldset class="admin-card"><legend>Identidad y dominio</legend><label>Nombre del sitio<input name="siteName" value="Dr. Ronald Salazar" /></label><label>Descriptor<input name="descriptor" value="Ginecología Integral" /></label><label>URL pública<input name="siteUrl" type="url" placeholder="https://dominio.com" /></label><label>Idioma predeterminado<select name="defaultLocale"><option value="es">Español</option><option value="en">English</option></select></label></fieldset>
        <fieldset class="admin-card"><legend>Contacto y medición</legend><label>WhatsApp<input name="whatsapp" placeholder="Pendiente" /></label><label>Teléfono<input name="phone" placeholder="Pendiente" /></label><label>Correo destinatario<input name="recipient" type="email" placeholder="Pendiente" /></label><label>Google Analytics ID<input name="analyticsId" placeholder="G-XXXXXXXXXX" /></label></fieldset>
        <fieldset class="admin-card settings-wide"><legend>Publicación y privacidad</legend><div class="check-grid"><label><input type="checkbox" name="privacyApproved" /> Política de privacidad aprobada</label><label><input type="checkbox" name="termsApproved" /> Términos aprobados</label><label><input type="checkbox" name="imageRights" /> Permisos de fotografías registrados</label><label><input type="checkbox" name="brandApproved" /> Identidad visual aprobada</label><label><input type="checkbox" name="medicalWorkflow" /> Responsable de revisión médica definido</label><label><input type="checkbox" name="searchConsole" /> Search Console verificado</label></div></fieldset>
        <div class="settings-actions"><button class="admin-primary" type="submit">Guardar configuración</button></div>
      </form>
    </section>

    <section class="admin-view" data-panel="backup" hidden>
      <div class="admin-section-heading"><div><p class="admin-kicker">Portabilidad</p><h2>Respaldo e importación</h2></div><p>{databaseMode ? 'Exporta una copia adicional de PostgreSQL o restaura contenido editorial validado.' : 'Exporta todos los registros antes de limpiar el navegador o cambiar de computadora.'}</p></div>
      <div class="backup-grid">
        <article class="admin-card"><h3>Exportar copia completa</h3><p>Descarga contenido, configuración e historial como JSON portable.</p><button class="admin-primary" type="button" id="export-data">Descargar respaldo</button></article>
        <article class="admin-card"><h3>Importar respaldo</h3><p>Restaura un archivo exportado por este panel. Se valida antes de reemplazar datos.</p><label class="file-button">Seleccionar archivo<input type="file" id="import-data" accept="application/json" /></label></article>
        <article class="admin-card danger-card"><h3>Restablecer contenido</h3><p>{databaseMode ? 'Reemplaza los registros actuales de PostgreSQL por el contenido inicial. La configuración se conserva.' : 'Recupera el contenido inicial del proyecto y elimina las ediciones de este navegador.'}</p><button type="button" class="danger-button" id="reset-data">Restablecer</button></article>
      </div>
      <article class="admin-card integration-card"><p class="admin-kicker">Infraestructura</p><h3>{databaseMode ? 'PostgreSQL y Railway Bucket conectados' : 'Modo local de desarrollo'}</h3><p>{databaseMode ? 'Cada cambio se guarda individualmente mediante una API protegida y las imágenes se almacenan fuera de la base de datos.' : 'Al configurar Railway, el mismo panel cambia automáticamente a persistencia PostgreSQL y almacenamiento de objetos.'}</p><code>API: /api/admin/content · /api/admin/settings · /api/admin/media · /api/admin/state</code></article>
    </section>
  </main>

  <dialog id="record-dialog" class="record-dialog">
    <form method="dialog" id="record-form">
      <div class="dialog-heading"><div><p class="admin-kicker">Editor</p><h2 id="dialog-title">Nuevo contenido</h2></div><button type="button" class="dialog-close" data-close-dialog aria-label="Cerrar">×</button></div>
      <input type="hidden" name="id" />
      <div class="record-grid">
        <label>Colección<select name="collection" required><option value="pages">Página</option><option value="services">Servicio</option><option value="articles">Artículo</option><option value="team">Equipo</option><option value="locations">Ubicación</option><option value="resources">Recurso</option><option value="media">Medio / imagen</option></select></label>
        <label>Idioma<select name="locale" required><option value="es">Español</option><option value="en">English</option></select></label>
        <label class="record-wide">Título<input name="title" required maxlength="120" /></label>
        <label>Slug<input name="slug" required maxlength="180" autocapitalize="none" spellcheck="false" title="Solo minúsculas, números, guiones y barras; sin espacios ni acentos." pattern="[a-z0-9]+(?:[a-z0-9\-\/]*[a-z0-9])?" /></label>
        <label>Estado<select name="status" required><option value="draft">Borrador</option><option value="pending-medical-review">Revisión médica pendiente</option><option value="approved">Aprobado</option><option value="published">Publicado</option><option value="archived">Archivado</option></select></label>
        <label class="record-wide">Resumen<textarea name="summary" rows="4" required></textarea></label>
        <label class="record-wide">Contenido principal<textarea name="body" rows="10" placeholder="Texto completo del artículo o contenido editorial"></textarea></label>
        <label>Autor<input name="author" maxlength="120" /></label>
        <label>Revisor médico<input name="medicalReviewer" maxlength="120" /></label>
        <label>Fecha de revisión<input name="reviewDate" type="date" /></label>
        <label class="record-wide">Fuentes<textarea name="sources" rows="4" placeholder="Una referencia o URL por línea"></textarea></label>
        <label class="record-wide">Notas editoriales<textarea name="notes" rows="4"></textarea></label>
        <label class="record-wide">Texto alternativo de imagen<input name="altText" maxlength="180" placeholder="Describe la imagen para quien no puede verla" /></label>
        <label class="record-wide media-upload">Archivo de imagen<input name="imageFile" type="file" accept="image/jpeg,image/png,image/webp,image/avif" /><small>{databaseMode ? 'Railway Bucket: JPEG, PNG, WebP o AVIF; máximo 8 MB.' : 'Modo local: máximo 1 MB. El archivo se incluirá en el respaldo JSON.'}</small></label>
        <label class="record-wide remove-image" data-remove-image hidden><input type="checkbox" name="removeImage" /> Quitar la imagen actual</label>
        <input type="hidden" name="imageData" />
        <input type="hidden" name="imageKey" />
      </div>
      <p class="form-help">Publicar contenido médico requiere aprobación. El panel conserva el estado y el historial de cada cambio.</p>
      <div class="dialog-actions"><button type="button" class="secondary-button" data-close-dialog>Cancelar</button><button type="submit" class="admin-primary">Guardar registro</button></div>
    </form>
  </dialog>

  <div class="admin-toast" id="admin-toast" role="status" aria-live="polite"></div>
</div>

<script>
  type RecordItem = { id: string; collection: string; locale: string; status: string; title: string; slug: string; summary: string; body?: string; updatedAt: string; notes: string; author?: string; medicalReviewer?: string; reviewDate?: string; sources?: string; altText?: string; imageData?: string; imageKey?: string };
  type AuditItem = { id: string; message: string; at: string };
  type AdminState = { version: number; records: RecordItem[]; settings: Record<string, string | boolean>; audit: AuditItem[]; seeded?: boolean };

  class RequestError extends Error {
    constructor(message: string, readonly status: number) { super(message); }
  }

  const app = document.querySelector<HTMLElement>('[data-admin-app]');
  if (app) {
    const storageKey = 'ronald-salazar-admin-v1';
    const remoteMode = app.dataset.adminMode === 'database';
    const seed = JSON.parse(app.dataset.seed || '[]') as RecordItem[];
    const initialLocalState = (): AdminState => ({ version: 3, records: structuredClone(seed), settings: {}, audit: [{ id: crypto.randomUUID(), message: 'Panel local inicializado', at: new Date().toISOString() }] });
    let state: AdminState = { version: 3, records: [], settings: {}, audit: [] };
    // Hasta que la carga inicial funcione no se permite ningún cambio: así un
    // fallo temporal nunca termina sobrescribiendo la base con datos vacíos.
    let ready = false;
    let busy = false;

    const $ = <T extends Element>(selector: string) => app.querySelector<T>(selector);
    const $$ = <T extends Element>(selector: string) => [...app.querySelectorAll<T>(selector)];
    const labels: Record<string, string> = { pages: 'Páginas', services: 'Servicios', articles: 'Artículos', team: 'Equipo', locations: 'Ubicaciones', resources: 'Recursos', media: 'Medios' };
    const statuses: Record<string, string> = { draft: 'Borrador', 'pending-medical-review': 'Revisión médica', approved: 'Aprobado', published: 'Publicado', archived: 'Archivado' };
    const tableBody = $('#content-table-body') as HTMLTableSectionElement;
    const dialog = $('#record-dialog') as HTMLDialogElement;
    const form = $('#record-form') as HTMLFormElement;
    const settingsForm = $('#settings-form') as HTMLFormElement;
    const toast = $('#admin-toast') as HTMLElement;
    const indicator = $('#save-indicator') as HTMLElement;
    const dateFormat = new Intl.DateTimeFormat('es-CR', { dateStyle: 'medium', timeStyle: 'short' });
    let toastTimer = 0;

    const escapeHtml = (value: string) => String(value ?? '').replace(/[&<>'"]/g, (char) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', "'":'&#39;', '"':'&quot;' })[char] || char);
    const formatDate = (value: string) => { const date = new Date(value); return Number.isNaN(date.getTime()) ? '—' : dateFormat.format(date); };
    const showToast = (message: string) => { toast.textContent = message; toast.classList.add('is-visible'); window.clearTimeout(toastTimer); toastTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 3200); };
    const errorMessage = (error: unknown) => error instanceof Error && error.message ? error.message : 'No se pudo completar la acción.';

    const request = async <T,>(input: string, init: RequestInit = {}, timeoutMs = 12_000): Promise<T> => {
      const controller = new AbortController();
      const timer = window.setTimeout(() => controller.abort(), timeoutMs);
      let response: Response;
      try { response = await fetch(input, { ...init, signal: controller.signal }); }
      catch { throw new RequestError('No hubo respuesta del servidor. Revisa la conexión e inténtalo de nuevo.', 0); }
      finally { window.clearTimeout(timer); }
      const body = response.status === 204 ? undefined : await response.json().catch(() => undefined);
      if (response.status === 401) {
        window.setTimeout(() => { location.href = `/admin/login/?next=${encodeURIComponent(location.pathname)}`; }, 1800);
      }
      if (!response.ok) throw new RequestError(body?.error || 'No se pudo completar la acción.', response.status);
      return body as T;
    };
    const jsonRequest = <T,>(input: string, method: string, payload: unknown) => request<T>(input, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });

    const loadRemote = async () => {
      let remote = await request<AdminState>('/api/admin/state/');
      if (!remote.seeded && !remote.records.length) {
        await request('/api/admin/seed/', { method: 'POST' });
        remote = await request<AdminState>('/api/admin/state/');
      }
      return remote;
    };
    const readLocal = (): AdminState => {
      try {
        const saved = JSON.parse(localStorage.getItem(storageKey) || '') as AdminState;
        if (Array.isArray(saved?.records)) return { version: 3, records: saved.records, settings: saved.settings || {}, audit: Array.isArray(saved.audit) ? saved.audit : [] };
      } catch { /* sin datos locales válidos */ }
      return initialLocalState();
    };
    const writeLocal = (next: AdminState) => {
      try { localStorage.setItem(storageKey, JSON.stringify(next)); }
      catch { throw new Error('El navegador no tiene espacio para guardar. Exporta un respaldo y elimina imágenes grandes.'); }
    };
    const addLocalAudit = (draft: AdminState, message: string) => { draft.audit.unshift({ id: crypto.randomUUID(), message, at: new Date().toISOString() }); draft.audit = draft.audit.slice(0, 60); };

    /**
     * Aplica un cambio. En modo base de datos se envía solo esa operación y luego
     * se recarga el estado del servidor; en modo local se edita una copia. En
     * ambos casos el estado visible cambia solo si el guardado tuvo éxito.
     */
    const commit = async (successMessage: string, remote: () => Promise<unknown>, local: (draft: AdminState) => void) => {
      indicator.textContent = 'Guardando…';
      try {
        if (remoteMode) {
          await remote();
          state = await loadRemote();
        } else {
          const draft = structuredClone(state);
          local(draft);
          writeLocal(draft);
          state = draft;
        }
        indicator.textContent = 'Todo guardado';
        showToast(successMessage);
        renderAll();
        return true;
      } catch (error) {
        indicator.textContent = 'Error al guardar';
        showToast(errorMessage(error));
        if (remoteMode && error instanceof RequestError && error.status === 409) {
          try { state = await loadRemote(); renderAll(); indicator.textContent = 'Datos actualizados'; } catch { /* se mantiene el estado anterior */ }
        }
        return false;
      }
    };
    const exclusive = async (task: () => Promise<unknown>) => {
      if (!ready) { showToast('El panel no pudo cargar los datos. Recarga la página antes de hacer cambios.'); return; }
      if (busy) return;
      busy = true;
      app.setAttribute('aria-busy', 'true');
      try { await task(); } finally { busy = false; app.removeAttribute('aria-busy'); }
    };

    function switchView(view: string) {
      const target = ['dashboard', 'content', 'settings', 'backup'].includes(view) ? view : 'dashboard';
      $$<HTMLElement>('[data-panel]').forEach((panel) => panel.hidden = panel.dataset.panel !== target);
      $$<HTMLButtonElement>('[data-view]').forEach((button) => button.classList.toggle('is-active', button.dataset.view === target));
      history.replaceState(null, '', `#${target}`);
    }

    function renderMetrics() {
      const counts = [
        ['Registros', state.records.length],
        ['Revisión médica', state.records.filter((item) => item.status === 'pending-medical-review').length],
        ['Aprobados', state.records.filter((item) => item.status === 'approved').length],
        ['Publicados', state.records.filter((item) => item.status === 'published').length],
      ];
      const grid = $('#metric-grid');
      if (grid) grid.innerHTML = counts.map(([label, count], index) => `<article><span>0${index + 1}</span><strong>${count}</strong><p>${label}</p></article>`).join('');
    }

    function renderDashboard() {
      const recent = [...state.records].sort((a, b) => String(b.updatedAt).localeCompare(String(a.updatedAt))).slice(0, 6);
      const recentList = $('#recent-list');
      if (recentList) recentList.innerHTML = recent.map((item) => `<button type="button" data-edit="${escapeHtml(item.id)}"><span>${escapeHtml(item.title)}</span><small>${labels[item.collection] || escapeHtml(item.collection)} · ${statuses[item.status] || escapeHtml(item.status)}</small><b>${formatDate(item.updatedAt)}</b></button>`).join('');
      const settingsReady = ['siteUrl','whatsapp','phone','recipient'].filter((key) => Boolean(state.settings[key])).length;
      const approvals = ['privacyApproved','termsApproved','imageRights','brandApproved','medicalWorkflow','searchConsole'].filter((key) => state.settings[key] === true).length;
      const approvedContent = state.records.length ? state.records.filter((item) => ['approved','published'].includes(item.status)).length / state.records.length : 0;
      const readiness = Math.round(((settingsReady / 4) * .3 + (approvals / 6) * .35 + approvedContent * .35) * 100);
      ($('#readiness-value') as HTMLElement).textContent = `${readiness}%`;
      ($('#readiness-bar') as HTMLElement).style.width = `${readiness}%`;
      ($('#readiness-list') as HTMLElement).innerHTML = [`Dominio y contacto: ${settingsReady}/4`, `Aprobaciones operativas: ${approvals}/6`, `Contenido aprobado: ${Math.round(approvedContent * 100)}%`].map((item) => `<li>${item}</li>`).join('');
      const audit = $('#audit-list');
      if (audit) audit.innerHTML = state.audit.length ? state.audit.slice(0, 10).map((item) => `<div><span></span><p>${escapeHtml(item.message)}<small>${formatDate(item.at)}</small></p></div>`).join('') : '<p class="empty-state">Sin actividad registrada.</p>';
    }

    function filteredRecords() {
      const query = (($('#content-search') as HTMLInputElement)?.value || '').toLowerCase();
      const collection = ($('#collection-filter') as HTMLSelectElement)?.value || 'all';
      const status = ($('#status-filter') as HTMLSelectElement)?.value || 'all';
      return state.records.filter((item) => (!query || `${item.title} ${item.slug}`.toLowerCase().includes(query)) && (collection === 'all' || item.collection === collection) && (status === 'all' || item.status === status));
    }

    function renderTable() {
      const records = filteredRecords();
      tableBody.innerHTML = records.map((item) => `<tr><td><div class="content-name">${item.imageData ? `<img src="${escapeHtml(item.imageData)}" alt="" />` : ''}<div><strong>${escapeHtml(item.title)}</strong><small>/${escapeHtml(item.slug)}/</small></div></div></td><td>${labels[item.collection] || escapeHtml(item.collection)}</td><td><span class="locale-pill">${escapeHtml(String(item.locale).toUpperCase())}</span></td><td><span class="status-pill status-${escapeHtml(item.status)}">${statuses[item.status] || escapeHtml(item.status)}</span></td><td>${formatDate(item.updatedAt)}</td><td><div class="row-actions"><button type="button" data-edit="${escapeHtml(item.id)}">Editar</button><button type="button" data-duplicate="${escapeHtml(item.id)}">Duplicar</button><button type="button" data-delete="${escapeHtml(item.id)}">Eliminar</button></div></td></tr>`).join('');
      const empty = $('#empty-state') as HTMLElement;
      empty.hidden = records.length > 0;
    }

    function loadSettings() {
      if (!settingsForm) return;
      [...settingsForm.elements].forEach((control) => {
        if (!(control instanceof HTMLInputElement || control instanceof HTMLSelectElement)) return;
        if (control.type === 'checkbox') (control as HTMLInputElement).checked = state.settings[control.name] === true;
        else if (state.settings[control.name] !== undefined) control.value = String(state.settings[control.name]);
      });
    }

    function renderAll() { renderMetrics(); renderDashboard(); renderTable(); loadSettings(); }

    const slugOwner = (record: Pick<RecordItem, 'id' | 'collection' | 'locale' | 'slug'>) => state.records.find((item) => item.id !== record.id && item.collection === record.collection && item.locale === record.locale && item.slug === record.slug);
    const uniqueCopySlug = (source: RecordItem) => {
      const taken = new Set(state.records.filter((item) => item.collection === source.collection && item.locale === source.locale).map((item) => item.slug));
      let candidate = `${source.slug}-copia`;
      for (let index = 2; taken.has(candidate); index += 1) candidate = `${source.slug}-copia-${index}`;
      return candidate;
    };
    const recordPayload = (record: RecordItem, existing?: RecordItem) => existing
      ? jsonRequest(`/api/admin/content/${encodeURIComponent(record.id)}/`, 'PATCH', { ...record, baseUpdatedAt: existing.updatedAt })
      : jsonRequest('/api/admin/content/', 'POST', record);
    const upsertLocal = (draft: AdminState, record: RecordItem) => {
      const index = draft.records.findIndex((item) => item.id === record.id);
      if (index >= 0) draft.records[index] = record; else draft.records.unshift(record);
    };

    function openRecord(id?: string) {
      if (!ready) { showToast('El panel no pudo cargar los datos. Recarga la página.'); return; }
      form.reset();
      ($('#dialog-title') as HTMLElement).textContent = id ? 'Editar contenido' : 'Nuevo contenido';
      const removeImage = $('[data-remove-image]') as HTMLElement;
      removeImage.hidden = true;
      (form.elements.namedItem('id') as HTMLInputElement).value = '';
      (form.elements.namedItem('imageData') as HTMLInputElement).value = '';
      (form.elements.namedItem('imageKey') as HTMLInputElement).value = '';
      if (id) {
        const record = state.records.find((item) => item.id === id);
        if (!record) return;
        Object.entries(record).forEach(([key, value]) => { const control = form.elements.namedItem(key); if ((control instanceof HTMLInputElement && control.type !== 'file') || control instanceof HTMLSelectElement || control instanceof HTMLTextAreaElement) control.value = String(value ?? ''); });
        removeImage.hidden = !record.imageData;
      }
      dialog.showModal();
      // Foco inmediato: con un temporizador el foco podía saltar al título
      // mientras la persona ya escribía en otro campo.
      (form.elements.namedItem('title') as HTMLInputElement)?.focus();
    }

    app.addEventListener('click', (event) => {
      const target = (event.target as HTMLElement).closest<HTMLElement>('button, [data-view-link]');
      if (!target) return;
      if (target.dataset.view) switchView(target.dataset.view);
      if (target.dataset.viewLink) switchView(target.dataset.viewLink);
      if (target.hasAttribute('data-new-record')) openRecord();
      if (target.hasAttribute('data-close-dialog')) dialog.close();
      if (target.dataset.edit) openRecord(target.dataset.edit);
      if (target.dataset.duplicate) {
        const source = state.records.find((item) => item.id === target.dataset.duplicate);
        if (source) void exclusive(async () => {
          const copy: RecordItem = { ...source, id: crypto.randomUUID(), title: `${source.title} — copia`.slice(0, 120), slug: uniqueCopySlug(source), status: 'draft', updatedAt: new Date().toISOString() };
          await commit('Registro duplicado', () => recordPayload(copy), (draft) => { upsertLocal(draft, copy); addLocalAudit(draft, `Duplicado: ${source.title}`); });
        });
      }
      if (target.dataset.delete) {
        const record = state.records.find((item) => item.id === target.dataset.delete);
        if (record && confirm(`¿Eliminar “${record.title}”? Esta acción se registra en el historial.`)) void exclusive(() => commit(
          'Registro eliminado',
          () => request(`/api/admin/content/${encodeURIComponent(record.id)}/`, { method: 'DELETE' }),
          (draft) => { draft.records = draft.records.filter((item) => item.id !== record.id); addLocalAudit(draft, `Eliminado: ${record.title}`); },
        ));
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      void exclusive(async () => {
        const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
        const existing = state.records.find((item) => item.id === data.id);
        const record: RecordItem = { id: data.id || crypto.randomUUID(), collection: data.collection, locale: data.locale, status: data.status, title: data.title.trim(), slug: data.slug.trim().toLowerCase(), summary: data.summary.trim(), body: data.body.trim(), notes: data.notes.trim(), author: data.author.trim(), medicalReviewer: data.medicalReviewer.trim(), reviewDate: data.reviewDate, sources: data.sources.trim(), altText: data.altText.trim(), imageData: data.imageData || '', imageKey: data.imageKey || '', updatedAt: new Date().toISOString() };
        if (record.collection === 'articles' && record.slug.includes('/')) { showToast('El slug de un artículo no puede contener “/”.'); return; }
        const owner = slugOwner(record);
        if (owner) { showToast(`El slug “${record.slug}” ya lo usa “${owner.title}” en la misma colección e idioma.`); return; }
        if (data.removeImage === 'on') { record.imageData = ''; record.imageKey = ''; }

        const file = (form.elements.namedItem('imageFile') as HTMLInputElement).files?.[0];
        let uploadedKey = '';
        if (file) {
          if (remoteMode) {
            indicator.textContent = 'Subiendo imagen…';
            const upload = new FormData();
            upload.set('file', file);
            upload.set('altText', record.altText || '');
            try {
              const result = await request<{ url: string; key: string }>('/api/admin/media/', { method: 'POST', body: upload }, 45_000);
              record.imageData = result.url;
              record.imageKey = result.key;
              uploadedKey = result.key;
            } catch (error) {
              indicator.textContent = 'Error al guardar';
              showToast(errorMessage(error));
              return;
            }
          } else {
            if (file.size > 1024 * 1024) { showToast('La imagen supera el máximo local de 1 MB'); return; }
            record.imageData = await new Promise<string>((resolve, reject) => { const reader = new FileReader(); reader.onload = () => resolve(String(reader.result)); reader.onerror = () => reject(reader.error); reader.readAsDataURL(file); });
            record.imageKey = '';
          }
        }

        const saved = await commit('Contenido guardado', () => recordPayload(record, existing), (draft) => { upsertLocal(draft, record); addLocalAudit(draft, `${existing ? 'Actualizado' : 'Creado'}: ${record.title}`); });
        if (saved) dialog.close();
        else if (uploadedKey) void request(`/api/admin/media/?key=${encodeURIComponent(uploadedKey)}`, { method: 'DELETE' }).catch(() => undefined);
      });
    });

    settingsForm.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!settingsForm.reportValidity()) return;
      const settings: Record<string, string | boolean> = {};
      [...settingsForm.elements].forEach((control) => {
        if (control instanceof HTMLInputElement && control.type === 'checkbox') settings[control.name] = control.checked;
        else if ((control instanceof HTMLInputElement || control instanceof HTMLSelectElement) && control.name) settings[control.name] = control.value.trim();
      });
      void exclusive(() => commit('Configuración guardada', () => jsonRequest('/api/admin/settings/', 'PUT', settings), (draft) => { draft.settings = settings; addLocalAudit(draft, 'Configuración actualizada'); }));
    });

    (form.elements.namedItem('slug') as HTMLInputElement).addEventListener('input', (event) => {
      const input = event.currentTarget as HTMLInputElement;
      const lower = input.value.toLowerCase();
      if (lower !== input.value) { const position = input.selectionStart; input.value = lower; input.setSelectionRange(position, position); }
    });
    ['content-search','collection-filter','status-filter'].forEach((id) => $(`#${id}`)?.addEventListener('input', renderTable));
    $('#clear-audit')?.addEventListener('click', () => {
      if (confirm('¿Limpiar el registro de actividad local?')) void exclusive(() => commit('Historial limpiado', async () => undefined, (draft) => { draft.audit = []; }));
    });
    $('#export-data')?.addEventListener('click', () => void exclusive(async () => {
      try {
        const snapshot = remoteMode ? await loadRemote() : state;
        const blob = new Blob([JSON.stringify({ ...snapshot, exportedAt: new Date().toISOString() }, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `dr-ronald-admin-${new Date().toISOString().slice(0,10)}.json`;
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 1_000);
        showToast('Respaldo descargado');
      } catch (error) { showToast(errorMessage(error)); }
    }));
    $('#import-data')?.addEventListener('change', async (event) => {
      const input = event.currentTarget as HTMLInputElement;
      const file = input.files?.[0];
      if (!file) return;
      let imported: AdminState;
      try {
        imported = JSON.parse(await file.text()) as AdminState;
        const validRecords = Array.isArray(imported.records) && imported.records.every((item) => item && typeof item.id === 'string' && typeof item.title === 'string' && typeof item.slug === 'string');
        if (!validRecords || (imported.settings !== undefined && typeof imported.settings !== 'object')) throw new Error();
      } catch {
        showToast('El archivo no es un respaldo válido');
        input.value = '';
        return;
      } finally { input.value = ''; }
      if (!confirm(`¿Reemplazar todo el contenido actual por los ${imported.records.length} registros del respaldo?`)) return;
      const records = imported.records.map((item) => ({ ...item, updatedAt: Number.isNaN(Date.parse(item.updatedAt)) ? new Date().toISOString() : item.updatedAt }));
      void exclusive(() => commit(
        'Respaldo restaurado',
        () => jsonRequest('/api/admin/state/', 'PUT', { mode: 'import', records, settings: imported.settings }),
        (draft) => { draft.records = records; draft.settings = imported.settings || draft.settings; addLocalAudit(draft, 'Respaldo importado'); },
      ));
    });
    $('#reset-data')?.addEventListener('click', () => {
      if (!confirm(remoteMode ? '¿Reemplazar el contenido de PostgreSQL por los datos iniciales? Exporta una copia antes.' : '¿Restablecer todos los datos locales? Exporta una copia antes si deseas conservarlos.')) return;
      void exclusive(() => commit(
        'Datos iniciales restaurados',
        () => jsonRequest('/api/admin/state/', 'PUT', { mode: 'reset' }),
        (draft) => { const fresh = initialLocalState(); draft.records = fresh.records; draft.settings = {}; draft.audit = fresh.audit; },
      ));
    });
    window.addEventListener('hashchange', () => switchView(location.hash.slice(1)));

    const initialize = async () => {
      switchView(location.hash.slice(1));
      try {
        state = remoteMode ? await loadRemote() : readLocal();
        ready = true;
        indicator.textContent = 'Todo guardado';
      } catch (error) {
        indicator.textContent = 'Sin conexión';
        showToast(`${errorMessage(error)} Recarga la página para intentarlo de nuevo.`);
      }
      renderAll();
    };
    void initialize();
  }
</script>
