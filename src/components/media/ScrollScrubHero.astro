---
import type { ImageMetadata } from 'astro';
import type { HomeContent } from '@/data/home';
import type { Locale } from '@/lib/i18n';
import { contactDetails } from '@/data/contact';
import ResponsiveImage from '@/components/media/ResponsiveImage.astro';

interface Props {
  locale: Locale;
  content: HomeContent['hero'];
  poster: ImageMetadata;
  videoSrc: string;
  mobileVideoSrc: string;
}

const { locale, content, poster, videoSrc, mobileVideoSrc } = Astro.props;
---

<section class="scroll-hero" data-scroll-hero data-motion-ignore aria-labelledby="hero-title">
  <div class="scroll-hero-stage">
    <div class="scroll-hero-media" aria-hidden="true">
      <ResponsiveImage
        src={poster}
        alt=""
        widths={[640, 960, 1280, 1600, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="scroll-hero-poster"
      />
      <video
        class="scroll-hero-video"
        muted
        playsinline
        webkit-playsinline
        preload="auto"
        disablepictureinpicture
        tabindex="-1"
        poster={poster.src}
        data-scroll-hero-video
        data-mobile-video-src={mobileVideoSrc}
        data-desktop-video-src={videoSrc}
      ></video>
      <span class="scroll-hero-scrim"></span>
      <span class="scroll-hero-transition"></span>
    </div>

    <div class="scroll-hero-content page-shell" data-scroll-hero-copy>
      <p class="eyebrow">{content.eyebrow}</p>
      <h1 id="hero-title">{content.title}</h1>
      <p class="hero-intro">{content.intro}</p>
      <div class="button-row">
        <a
          class="button button-primary"
          href={contactDetails.whatsapp.href}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics-event="click_whatsapp"
          data-analytics-placement="hero"
        >{content.primary}</a>
        <a class="text-link" href="#servicios">{content.secondary}<span aria-hidden="true"> →</span></a>
      </div>
      <p class="micro-note">{content.note}</p>
    </div>

    <div class="scroll-hero-content scroll-hero-content-secondary page-shell" data-scroll-hero-copy-secondary>
      <p class="eyebrow">{locale === 'es' ? 'Atención centrada en la persona' : 'Person-centered care'}</p>
      <h2>{locale === 'es' ? 'Claridad para decidir cada siguiente paso.' : 'Clarity for every next step.'}</h2>
      <p class="hero-intro">{locale === 'es'
        ? 'Información comprensible, valoración individual y acompañamiento respetuoso en cada etapa.'
        : 'Clear information, individual evaluation, and respectful support at every stage.'}</p>
    </div>

    <p class="scroll-hero-cue" data-scroll-hero-cue aria-hidden="true">
      <span></span>{locale === 'es' ? 'Desliza para continuar' : 'Scroll to continue'}
    </p>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  ScrollTrigger.config({ ignoreMobileResize: true });

  const initializeScrollHeroes = () => {
    document.querySelectorAll<HTMLElement>('[data-scroll-hero]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const video = root.querySelector<HTMLVideoElement>('[data-scroll-hero-video]');
      const stage = root.querySelector<HTMLElement>('.scroll-hero-stage');
      const copy = root.querySelector<HTMLElement>('[data-scroll-hero-copy]');
      const secondaryCopy = root.querySelector<HTMLElement>('[data-scroll-hero-copy-secondary]');
      const cue = root.querySelector<HTMLElement>('[data-scroll-hero-cue]');
      const transition = root.querySelector<HTMLElement>('.scroll-hero-transition');
      const poster = root.querySelector<HTMLElement>('.scroll-hero-poster');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
      const mobileQuery = window.matchMedia('(max-width: 47.99rem)');
      let timeline: gsap.core.Timeline | undefined;
      let resizeTimer = 0;
      let loadTimer = 0;
      let seekFrame = 0;
      let targetTime = 0;
      let viewportWidth = window.innerWidth;
      let videoDuration = 0;
      let videoReady = false;
      let fallbackApplied = false;
      let activationStarted = false;
      const playhead = { progress: 0 };
      const sourceFrameDuration = 1 / 24;

      const destroyTimeline = () => {
        timeline?.scrollTrigger?.kill();
        timeline?.kill();
        timeline = undefined;
      };

      const applyLatestFrame = () => {
        seekFrame = 0;
        if (!videoReady || !video || video.seeking || video.readyState < 2 || videoDuration <= 0 || Math.abs(video.currentTime - targetTime) < sourceFrameDuration * 0.45) return;
        try { video.currentTime = targetTime; } catch { showFallback(); }
      };

      const queueCurrentFrame = () => {
        if (!videoReady || videoDuration <= 0) return;
        const rawTime = playhead.progress * videoDuration;
        targetTime = Math.min(Math.max(0, videoDuration - 0.015), Math.round(rawTime / sourceFrameDuration) * sourceFrameDuration);
        if (!seekFrame) seekFrame = requestAnimationFrame(applyLatestFrame);
      };

      const buildTimeline = () => {
        if (timeline || !stage || !copy || !secondaryCopy || !transition || !poster) return;
        root.dataset.heroState = 'loading';

        timeline = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: root,
            start: 'top top',
            end: () => `+=${Math.round(window.innerHeight * (mobileQuery.matches ? 1.45 : 1.9))}`,
            pin: stage,
            pinSpacing: true,
            scrub: mobileQuery.matches ? 0.08 : 0.1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
          },
        });

        timeline
          .to(playhead, {
            progress: 1,
            duration: 1,
            onUpdate: queueCurrentFrame,
          }, 0)
          .to(cue, { autoAlpha: 0, duration: 0.18 }, 0.08)
          .to(copy, { autoAlpha: 0, y: -12, duration: 0.1 }, 0.4)
          .to(secondaryCopy, { autoAlpha: 1, y: 0, duration: 0.1 }, 0.5)
          .to(secondaryCopy, { autoAlpha: 0, y: -8, duration: 0.12 }, 0.86)
          .to(transition, { opacity: 1, duration: 0.16 }, 0.84)
          .to([video, poster].filter(Boolean), { autoAlpha: 0, duration: 0.12 }, 0.88);

        requestAnimationFrame(() => ScrollTrigger.refresh());
      };

      const showFallback = () => {
        if (fallbackApplied) return;
        fallbackApplied = true;
        window.clearTimeout(loadTimer);
        videoReady = false;
        root.dataset.heroState = 'fallback';
        if (video) {
          video.pause();
          video.removeAttribute('src');
          video.querySelectorAll('source').forEach((source) => source.remove());
          video.load();
        }
        if (reducedMotion.matches) destroyTimeline();
      };

      if (!stage || !copy || !secondaryCopy || !transition || !poster) {
        root.dataset.heroState = 'fallback';
        return;
      }

      if (reducedMotion.matches) {
        showFallback();
        return;
      }

      buildTimeline();

      const activateVideo = () => {
        if (!video || activationStarted || fallbackApplied) return;
        activationStarted = true;
        window.clearTimeout(loadTimer);
        let settled = false;
        const finish = () => {
          if (settled || fallbackApplied) return;
          settled = true;
          video.pause();
          videoReady = true;
          root.dataset.heroState = 'ready';
          queueCurrentFrame();
        };

        if (!mobileQuery.matches) {
          finish();
          return;
        }

        const playAttempt = video.play();
        if (playAttempt) playAttempt.then(finish).catch(finish);
        window.setTimeout(finish, 700);
      };

      const onMetadata = () => {
        if (!video || !Number.isFinite(video.duration) || video.duration <= 0) {
          showFallback();
          return;
        }
        videoDuration = video.duration;
        if (video.readyState >= 2) activateVideo();
        else video.addEventListener('loadeddata', activateVideo, { once: true });
      };

      const onSeeked = () => {
        if (video && Math.abs(video.currentTime - targetTime) > 0.02 && !seekFrame) seekFrame = requestAnimationFrame(applyLatestFrame);
      };
      const onPlayable = () => queueCurrentFrame();
      const onReducedMotionChange = (event: MediaQueryListEvent) => {
        if (event.matches) showFallback();
      };

      const refresh = () => {
        const nextWidth = window.innerWidth;
        if (Math.abs(nextWidth - viewportWidth) < 4) return;
        viewportWidth = nextWidth;
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => ScrollTrigger.refresh(), 180);
      };
      const refreshOrientation = () => {
        viewportWidth = window.innerWidth;
        window.clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => ScrollTrigger.refresh(), 220);
      };
      window.addEventListener('resize', refresh, { passive: true });
      window.addEventListener('orientationchange', refreshOrientation, { passive: true });
      reducedMotion.addEventListener('change', onReducedMotionChange);

      if (!video || saveData || !video.canPlayType('video/mp4')) {
        showFallback();
      } else {
        const selectedVideoSrc = mobileQuery.matches ? video.dataset.mobileVideoSrc : video.dataset.desktopVideoSrc;
        if (!selectedVideoSrc) {
          showFallback();
        } else {
          video.src = selectedVideoSrc;
          video.addEventListener('loadedmetadata', onMetadata, { once: true });
          video.addEventListener('seeked', onSeeked);
          video.addEventListener('loadeddata', onPlayable);
          video.addEventListener('canplay', onPlayable);
          video.addEventListener('error', showFallback, { once: true });
          loadTimer = window.setTimeout(showFallback, 12000);
          video.load();
        }
      }

      document.addEventListener('astro:before-swap', () => {
        window.clearTimeout(loadTimer);
        window.clearTimeout(resizeTimer);
        if (seekFrame) cancelAnimationFrame(seekFrame);
        destroyTimeline();
        window.removeEventListener('resize', refresh);
        window.removeEventListener('orientationchange', refreshOrientation);
        reducedMotion.removeEventListener('change', onReducedMotionChange);
        video?.removeEventListener('seeked', onSeeked);
        video?.removeEventListener('loadeddata', onPlayable);
        video?.removeEventListener('canplay', onPlayable);
      }, { once: true });
    });
  };

  initializeScrollHeroes();
  document.addEventListener('astro:page-load', initializeScrollHeroes);
</script>
