---
import type { Locale } from '@/lib/i18n';
import { absoluteUrl } from '@/lib/site';

interface Props { locale: Locale; title: string; pathname: string }
const { locale, title, pathname } = Astro.props;
const homeLabel = locale === 'es' ? 'Inicio' : 'Home';
const homePath = `/${locale}/`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: absoluteUrl(homePath) },
    { '@type': 'ListItem', position: 2, name: title, item: absoluteUrl(pathname) },
  ],
};
---
<nav class="breadcrumbs" aria-label={locale === 'es' ? 'Migas de pan' : 'Breadcrumbs'}>
  <ol><li><a href={homePath}>{homeLabel}</a></li><li aria-current="page">{title}</li></ol>
</nav>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
