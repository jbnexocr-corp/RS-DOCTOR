---
import type { Locale } from '@/lib/i18n';
import { absoluteUrl, site } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  pathname: string;
  alternatePathname: string;
  image?: string;
  noindex?: boolean;
  /** false cuando la página alterna no es una traducción exacta (por ejemplo, un artículo sin versión en el otro idioma). */
  alternateIsTranslation?: boolean;
}

const { title, description, locale, pathname, alternatePathname, image, noindex = false, alternateIsTranslation = true } = Astro.props;
const canonical = absoluteUrl(pathname);
const alternate = alternateIsTranslation ? absoluteUrl(alternatePathname) : undefined;
const xDefault = alternateIsTranslation ? absoluteUrl('/es/') : undefined;
const ogImage = image ? absoluteUrl(image) : undefined;
const ogLocale = locale === 'es' ? 'es_CR' : 'en_US';
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
{canonical && <link rel="canonical" href={canonical} />}
{canonical && alternate && <link rel="alternate" hreflang={locale} href={canonical} />}
{alternate && <link rel="alternate" hreflang={locale === 'es' ? 'en' : 'es'} href={alternate} />}
{xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImage && image === '/og/dr-ronald-salazar.jpg' && <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="Dr. Ronald Salazar, Ginecología Integral" /></>}
{ogImage && <meta name="twitter:image" content={ogImage} />}
<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
