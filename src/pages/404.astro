---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout locale="es" title="Página no encontrada | Dr. Ronald Salazar" description="La página solicitada no existe." pathname="/404/" alternatePathname="/404/" skipText="Saltar al contenido principal" noindex={true} alternateIsTranslation={false}>
  <main id="main-content" class="error-page page-shell">
    <p class="eyebrow">Error 404</p>
    <h1>Esta página no está disponible.</h1>
    <p>La dirección puede haber cambiado o el contenido todavía no se ha publicado.</p>
    <a class="button button-primary" href="/es/">Volver al inicio</a>
  </main>
</BaseLayout>
