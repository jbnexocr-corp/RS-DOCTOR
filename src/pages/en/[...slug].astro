---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { draftPagesNoindex } from '@/lib/site';
import InnerPage from '@/components/content/InnerPage.astro';
import { innerPages, type InnerPageContent } from '@/data/innerPages';

export function getStaticPaths() {
  return innerPages.en.filter((page) => page.kind !== 'articles').map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
export const prerender = true;

interface Props { page: InnerPageContent }
const { page } = Astro.props;
const pathname = `/en/${page.slug}/`;
const alternatePathname = `/es/${page.alternateSlug}/`;
---
<BaseLayout locale="en" title={`${page.title} | Dr. Ronald Salazar`} description={page.description} {pathname} {alternatePathname} skipText="Skip to main content" noindex={draftPagesNoindex}>
  <InnerPage locale="en" {page} {pathname} />
</BaseLayout>
