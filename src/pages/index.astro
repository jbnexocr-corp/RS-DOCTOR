<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <title>Dr. Ronald Salazar</title>
    <script is:inline>
      (() => {
        let saved = null;
        try { saved = localStorage.getItem('site-language-preference'); } catch { /* almacenamiento bloqueado */ }
        const locale = saved === 'es' || saved === 'en' ? saved : (navigator.language || '').toLowerCase().startsWith('es') ? 'es' : 'en';
        location.replace(`/${locale}/`);
      })();
    </script>
  </head>
  <body><main><p>Selecciona un idioma: <a href="/es/">Español</a> · <a href="/en/">English</a></p></main></body>
</html>
