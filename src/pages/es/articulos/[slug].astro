---
import ArticlePage from '@/components/content/ArticlePage.astro';
import { loadArticleForPage } from '@/lib/server/articles';
export const prerender = false;
const { slug = '' } = Astro.params;
const { article, serviceUnavailable } = await loadArticleForPage(Astro, 'es', slug);
---
<ArticlePage locale="es" {slug} {article} {serviceUnavailable} />
