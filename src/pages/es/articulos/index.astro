---
import BaseLayout from '@/layouts/BaseLayout.astro';
import InnerPage from '@/components/content/InnerPage.astro';
import { innerPages } from '@/data/innerPages';
import { loadArticleListForPage } from '@/lib/server/articles';
export const prerender = false;
const page = innerPages.es.find((item) => item.kind === 'articles')!;
const pathname = '/es/articulos/';
const { articles, articlesUnavailable } = await loadArticleListForPage(Astro, 'es');
---
<BaseLayout locale="es" title={`${page.title} | Dr. Ronald Salazar`} description={page.description} {pathname} alternatePathname="/en/articles/" skipText="Saltar al contenido principal">
  <InnerPage locale="es" {page} {pathname} publishedArticles={articles} {articlesUnavailable} />
</BaseLayout>
